<resources>
    <style name="Theme.ScoreCast" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/sc_brand</item>
        <item name="colorOnPrimary">@color/sc_on_brand</item>
        <item name="colorPrimaryContainer">#3A1A0B</item>
        <item name="colorOnPrimaryContainer">#FFD9C8</item>
        <item name="colorSecondary">@color/sc_brand</item>
        <item name="colorSurface">@color/sc_bg</item>
        <item name="colorOnSurface">@color/sc_text</item>
        <item name="colorOnSurfaceVariant">@color/sc_muted</item>
        <item name="colorSurfaceContainer">@color/sc_surface</item>
        <item name="colorSurfaceContainerLow">@color/sc_surface</item>
        <item name="colorSurfaceContainerHigh">@color/sc_surface2</item>
        <item name="colorSurfaceContainerHighest">@color/sc_surface2</item>
        <item name="colorOutline">#4A4F5E</item>
        <item name="colorOutlineVariant">@color/sc_line</item>
        <item name="android:colorBackground">@color/sc_bg</item>
        <item name="android:windowBackground">@color/sc_bg</item>
        <item name="android:statusBarColor">@color/sc_bg</item>
        <item name="android:navigationBarColor">@color/sc_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.ScoreCast.Fullscreen" parent="Theme.ScoreCast">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#000000</item>
    </style>

    <!-- En-tête des étapes : « ÉTAPE 2 SUR 5 » -->
    <style name="StepLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/sc_brand</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ScreenTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/sc_text</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ScreenSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/sc_muted</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/sc_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Hint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/sc_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">30dp</item>
    </style>

    <style name="SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:textColor">@color/sc_text</item>
        <item name="cornerRadius">26dp</item>
    </style>

    <style name="Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/sc_surface</item>
        <item name="cardCornerRadius">20dp</item>
    </style>

    <style name="ControlButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">160dp</item>
        <!-- Texte toujours sur une seule ligne (ex. « Télécommande ») -->
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginVertical">4dp</item>
        <item name="backgroundTint">#CC2A2C35</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="ScoreButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="backgroundTint">#CC2A2C35</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
