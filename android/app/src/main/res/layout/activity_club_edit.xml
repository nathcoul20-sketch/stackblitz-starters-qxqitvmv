<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <include layout="@layout/step_header" />

            <!-- Aperçu du tableau de score, mis à jour en direct -->
            <FrameLayout
                android:id="@+id/previewBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="Aperçu du tableau de score" />
            </FrameLayout>

            <TextView
                style="@style/Hint"
                android:layout_marginTop="6dp"
                android:text="Aperçu du tableau de score incrusté dans le live." />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nameLayout"
                style="@style/Field"
                android:layout_marginTop="18dp"
                android:hint="Nom du club (affiché dans le live)"
                app:counterEnabled="true"
                app:counterMaxLength="20">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:maxLength="20" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/SectionTitle"
                android:text="Logo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pickLogo"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Choisir une image" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/removeLogo"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Retirer le logo"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Hint"
                android:layout_marginTop="8dp"
                android:text="Conseil : une image PNG à fond transparent rend mieux." />

            <TextView
                style="@style/SectionTitle"
                android:text="Couleur principale" />

            <TextView
                style="@style/Hint"
                android:layout_marginBottom="10dp"
                android:text="Case du nom du club, fonds des écrans d'intro et de fin." />

            <com.scorecast.app.ColorPaletteView
                android:id="@+id/primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/SectionTitle"
                android:text="Couleur secondaire" />

            <TextView
                style="@style/Hint"
                android:layout_marginBottom="10dp"
                android:text="Case du score, liserés et titres." />

            <com.scorecast.app.ColorPaletteView
                android:id="@+id/secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/colorWarning"
                style="@style/Hint"
                android:layout_marginTop="10dp"
                android:text="⚠ Les deux couleurs se ressemblent beaucoup : le score sera peu lisible."
                android:textColor="#F0A500"
                android:visibility="gone" />

            <!-- Écrans & vidéos -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/media"
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎬"
                        android:textSize="28sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Écrans &amp; vidéos (facultatif)"
                            android:textColor="@color/sc_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/mediaInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/sc_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="→"
                        android:textColor="@color/sc_brand"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/delete"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="Supprimer ce club"
                android:textColor="#E5484D"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/save"
        style="@style/PrimaryButton"
        android:layout_margin="20dp"
        android:text="Enregistrer et continuer" />
</LinearLayout>
