<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.pedro.library.view.OpenGlView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Statut du live -->
    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:background="@drawable/chip_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="Hors ligne"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Choix de la scène diffusée, à gauche -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="12dp">

        <Button
            android:id="@+id/sceneIntro"
            style="@style/ControlButton"
            android:layout_width="120dp"
            android:text="Intro" />

        <Button
            android:id="@+id/sceneMatch"
            style="@style/ControlButton"
            android:layout_width="120dp"
            android:text="Match" />

        <Button
            android:id="@+id/sceneOutro"
            style="@style/ControlButton"
            android:layout_width="120dp"
            android:text="Fin" />
    </LinearLayout>

    <!-- Boutons de contrôle, à droite -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="12dp">

        <Button
            android:id="@+id/live"
            style="@style/ControlButton"
            app:backgroundTint="#D00A0A"
            android:text="● LIVE" />

        <Button
            android:id="@+id/remote"
            style="@style/ControlButton"
            android:text="Télécommande" />

        <Button
            android:id="@+id/scorePanelToggle"
            style="@style/ControlButton"
            android:text="Score" />

        <Button
            android:id="@+id/switchCamera"
            style="@style/ControlButton"
            android:text="Caméra ⇄" />
    </LinearLayout>

    <!-- Panneau de score local (secours si pas de télécommande) -->
    <LinearLayout
        android:id="@+id/scorePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/chip_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">

        <Button android:id="@+id/homeMinus" style="@style/ScoreButton" android:text="−" />
        <Button android:id="@+id/homePlus" style="@style/ScoreButton" app:backgroundTint="#D00A0A" android:text="+1" />
        <Button android:id="@+id/undo" style="@style/ScoreButton" android:layout_width="wrap_content" android:text="Annuler" />
        <Button android:id="@+id/endSet" style="@style/ScoreButton" android:layout_width="wrap_content" android:text="Fin du set" />
        <Button android:id="@+id/awayPlus" style="@style/ScoreButton" app:backgroundTint="#8F8F8F" android:text="+1" />
        <Button android:id="@+id/awayMinus" style="@style/ScoreButton" android:text="−" />
    </LinearLayout>
</FrameLayout>
