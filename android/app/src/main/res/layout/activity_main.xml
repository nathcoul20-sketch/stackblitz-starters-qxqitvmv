<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Match en cours sauvegardé (appli fermée pendant un match) -->
        <Button
            android:id="@+id/resume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="64dp"
            android:paddingVertical="10dp"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            style="@style/SectionTitle"
            android:text="Diffusion en direct" />

        <Spinner
            android:id="@+id/platform"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/serverUrlLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="URL du serveur (rtmp:// ou rtmps://)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/serverUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Clé de diffusion (stream key)"
            app:endIconMode="password_toggle"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/streamKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Twitch : titre du live automatique -->
        <LinearLayout
            android:id="@+id/twitchSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/section_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/twitchAutoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mettre à jour le titre du live Twitch" />

            <TextView
                android:id="@+id/twitchTitlePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/twitchStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/twitchClientIdLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Client ID de l'application Twitch">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/twitchClientId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textNoSuggestions" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/twitchConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Connecter mon compte Twitch" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="Match" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Équipe à domicile">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/homeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLength="20" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Équipe visiteuse">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/awayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLength="20" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Compétition">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/competition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="60" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="Partenaires" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Leurs logos s'affichent sur l'écran de fin (« Merci à nos partenaires »). 8 logos maximum. Touchez un logo pour le retirer."
            android:textSize="13sp" />

        <GridLayout
            android:id="@+id/partners"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addPartner"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="+ Ajouter un logo" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/partnersInMatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Aussi pendant le match : un logo à la fois, en bas à droite (change toutes les 8 s)" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:text="Ouvrir la caméra"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Le score repart de 0 à chaque ouverture de la caméra. Les noms peuvent aussi être modifiés depuis la télécommande pendant le match."
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
